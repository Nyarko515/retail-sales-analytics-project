	partition Sales = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents(pDataFolder & "\sales_transactions.csv"), [Delimiter = ",", Columns = 14, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Removed duplicates" = Table.Distinct(#"Promoted headers", {"OrderID", "OrderDate", "CustomerID", "ProductID", "SalespersonID", "RegionID", "StoreID", "ChannelID", "Quantity", "UnitPrice", "Discount", "UnitCost", "PaymentMethod", "OrderStatus"}),
				  #"Changed column type" = Table.TransformColumnTypes(#"Removed duplicates", {{"OrderID", type text}, {"OrderDate", type text}, {"CustomerID", type text}, {"ProductID", type text}, {"SalespersonID", type text}, {"RegionID", type text}, {"StoreID", type text}, {"ChannelID", type text}, {"Quantity", Int64.Type}, {"UnitPrice", type number}, {"Discount", type number}, {"UnitCost", type number}, {"PaymentMethod", type text}, {"OrderStatus", type text}}, "en-US"),
				  #"Added custom" = Table.AddColumn(#"Changed column type", "OrderDateClean", each if Text.Contains([OrderDate], "/")
				then Date.FromText([OrderDate], [Format="dd/MM/yyyy", Culture="en-GB"])
				else Date.FromText([OrderDate], [Format="yyyy-MM-dd"])),
				  #"Removed columns" = Table.RemoveColumns(#"Added custom", {"OrderDate"}),
				  #"Renamed columns" = Table.RenameColumns(#"Removed columns", {{"OrderDateClean", "OrderDate"}}),
				  #"Reordered columns" = Table.ReorderColumns(#"Renamed columns", {"OrderID", "OrderDate", "CustomerID", "ProductID", "SalespersonID", "RegionID", "StoreID", "ChannelID", "Quantity", "UnitPrice", "Discount", "UnitCost", "PaymentMethod", "OrderStatus"}),
				  #"Changed column type 1" = Table.TransformColumnTypes(#"Reordered columns", {{"OrderDate", type date}}),
				  #"Merged queries" = Table.NestedJoin(#"Changed column type 1", {"StoreID"}, Stores, {"StoreID"}, "Stores", JoinKind.LeftOuter),
				  #"Expanded Stores" = Table.ExpandTableColumn(#"Merged queries", "Stores", {"RegionID"}, {"RegionID.1"}),
				  #"Removed columns 1" = Table.RemoveColumns(#"Expanded Stores", {"RegionID"}),
				  #"Renamed columns 1" = Table.RenameColumns(#"Removed columns 1", {{"RegionID.1", "RegionID"}}),
				  #"Reordered columns 1" = Table.ReorderColumns(#"Renamed columns 1", {"OrderID", "OrderDate", "CustomerID", "ProductID", "SalespersonID", "RegionID", "StoreID", "ChannelID", "Quantity", "UnitPrice", "Discount", "UnitCost", "PaymentMethod", "OrderStatus"}),
				  #"Added custom 1" = Table.AddColumn(#"Reordered columns 1", "DiscountFlag", each if [Discount] = null then "blank"
				else if [Discount] > 1 then "invalid > 100%"
				else if [Discount] >= 0.5 then "High (≥50%)"
				else "Normal"),
				  #"Added custom 2" = Table.AddColumn(#"Added custom 1", "DiscountClean", each if [Discount] = null then 0
				else if [Discount] > 1 then 0
				else [Discount]),
				  #"Merged queries 1" = Table.NestedJoin(#"Added custom 2", {"ProductID"}, Products, {"ProductID"}, "Products", JoinKind.LeftOuter),
				  #"Expanded Products" = Table.ExpandTableColumn(#"Merged queries 1", "Products", {"StandardCost"}, {"StandardCost"}),
				  #"Added custom 3" = Table.AddColumn(#"Expanded Products", "UnitCostClean", each if [UnitCost] = null then [StandardCost] else [UnitCost]),
				  #"Removed columns 2" = Table.RemoveColumns(#"Added custom 3", {"StandardCost"}),
				  #"Filtered rows" = Table.SelectRows(#"Removed columns 2", each ([ProductID] <> "P999")),
				  #"Trimmed text" = Table.TransformColumns(#"Filtered rows", {{"OrderID", each Text.Trim(_), type nullable text}, {"CustomerID", each Text.Trim(_), type nullable text}, {"ProductID", each Text.Trim(_), type nullable text}, {"SalespersonID", each Text.Trim(_), type nullable text}, {"RegionID", each Text.Trim(_), type nullable text}, {"StoreID", each Text.Trim(_), type nullable text}, {"ChannelID", each Text.Trim(_), type nullable text}, {"PaymentMethod", each Text.Trim(_), type nullable text}, {"OrderStatus", each Text.Trim(_), type nullable text}}),
				  #"Cleaned text" = Table.TransformColumns(#"Trimmed text", {{"OrderID", each Text.Clean(_), type nullable text}, {"CustomerID", each Text.Clean(_), type nullable text}, {"ProductID", each Text.Clean(_), type nullable text}, {"SalespersonID", each Text.Clean(_), type nullable text}, {"RegionID", each Text.Clean(_), type nullable text}, {"StoreID", each Text.Clean(_), type nullable text}, {"ChannelID", each Text.Clean(_), type nullable text}, {"PaymentMethod", each Text.Clean(_), type nullable text}, {"OrderStatus", each Text.Clean(_), type nullable text}}),
				  #"Changed column type 2" = Table.TransformColumnTypes(#"Cleaned text", {{"UnitCostClean", type number}, {"DiscountClean", type number}}),
				  #"Added custom 4" = Table.AddColumn(#"Changed column type 2", "GrossSales", each [Quantity] * [UnitPrice]),
				  #"Changed column type 3" = Table.TransformColumnTypes(#"Added custom 4", {{"GrossSales", type number}}),
				  #"Added custom 5" = Table.AddColumn(#"Changed column type 3", "DiscountAmount", each [GrossSales] * [DiscountClean]),
				  #"Changed column type 4" = Table.TransformColumnTypes(#"Added custom 5", {{"DiscountAmount", type number}}),
				  #"Added custom 6" = Table.AddColumn(#"Changed column type 4", "NetRevenue", each [GrossSales] - [DiscountAmount]),
				  #"Added custom 7" = Table.AddColumn(#"Added custom 6", "TotalCost", each [Quantity] * [UnitCostClean]),
				  #"Added custom 8" = Table.AddColumn(#"Added custom 7", "Profit", each [NetRevenue] - [TotalCost]),
				  #"Changed column type 5" = Table.TransformColumnTypes(#"Added custom 8", {{"NetRevenue", type number}, {"TotalCost", type number}, {"Profit", type number}}),
				  #"Added custom 9" = Table.AddColumn(#"Changed column type 5", "NegativeMarginFlag", each if [Profit] < 0 then 1 else 0)
				in
				  #"Added custom 9"

	annotation PBI_ResultType = Table

