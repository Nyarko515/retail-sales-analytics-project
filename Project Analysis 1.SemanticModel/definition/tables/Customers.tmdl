	partition Customers = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents(pDataFolder & "\customers.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"CustomerID", type text}, {"CustomerName", type text}, {"Gender", type text}, {"AgeGroup", type text}, {"RegionID", type text}, {"CustomerSegment", type text}, {"RegistrationDate", type date}}, "en-US"),
				  #"Trimmed text" = Table.TransformColumns(#"Changed column type", {{"CustomerName", each Text.Trim(_), type nullable text}}),
				  #"Cleaned text" = Table.TransformColumns(#"Trimmed text", {{"CustomerName", each Text.Clean(_), type nullable text}}),
				  #"Capitalized each word" = Table.TransformColumns(#"Cleaned text", {{"Gender", each Text.Proper(_), type nullable text}}),
				  #"Trimmed text 1" = Table.TransformColumns(#"Capitalized each word", {{"Gender", each Text.Trim(_), type nullable text}, {"CustomerSegment", each Text.Trim(_), type nullable text}}),
				  #"Cleaned text 1" = Table.TransformColumns(#"Trimmed text 1", {{"Gender", each Text.Clean(_), type nullable text}, {"CustomerSegment", each Text.Clean(_), type nullable text}}),
				  #"Capitalized each word 1" = Table.TransformColumns(#"Cleaned text 1", {{"CustomerSegment", each Text.Proper(_), type nullable text}}),
				  #"Added custom" = Table.AddColumn(#"Capitalized each word 1", "Custom", each if [Gender] = null or Text.Trim([Gender]) = ""
				then "Not applicable (business)"
				else [Gender]),
				  #"Changed column type 1" = Table.TransformColumnTypes(#"Added custom", {{"Custom", type text}}),
				  #"Renamed columns" = Table.RenameColumns(#"Changed column type 1", {{"Custom", "GenderClean"}}),
				  #"Added custom 1" = Table.AddColumn(#"Renamed columns", "AgeGroupClean", each if [AgeGroup] = null or Text.Trim([AgeGroup]) = ""
				then "Not applicable (business)"
				else [AgeGroup])
				in
				  #"Added custom 1"

	annotation PBI_ResultType = Table

