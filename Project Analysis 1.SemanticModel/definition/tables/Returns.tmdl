	partition Returns = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents(pDataFolder & "\returns.csv"), [Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Capitalized each word" = Table.TransformColumns(#"Promoted headers", {{"ReturnReason", each Text.Proper(_), type nullable text}}),
				  #"Added custom" = Table.AddColumn(#"Capitalized each word", "Custom", each if [ReturnDate] = null then null
				else if Text.Contains([ReturnDate], "/")
				then Date.FromText([ReturnDate], [Format="dd/MM/yyyy", Culture="en-GB"])
				else Date.FromText([ReturnDate], [Format="yyyy-MM-dd"])),
				  #"Changed column type" = Table.TransformColumnTypes(#"Added custom", {{"ReturnID", type text}, {"OrderID", type text}, {"ReturnDate", type date}, {"ProductID", type text}, {"QuantityReturned", Int64.Type}}, "en-US"),
				  #"Removed columns" = Table.RemoveColumns(#"Changed column type", {"Custom"}),
				  #"Added custom 1" = Table.AddColumn(#"Removed columns", "Custom", each if [ReturnDate] = null then null
				else if Value.Is([ReturnDate], type date) then [ReturnDate]
				else if Text.Contains(Text.From([ReturnDate]), "/")
				then Date.FromText(Text.From([ReturnDate]), [Format="dd/MM/yyyy", Culture="en-GB"])
				else Date.FromText(Text.From([ReturnDate]), [Format="yyyy-MM-dd"])),
				  #"Changed column type 1" = Table.TransformColumnTypes(#"Added custom 1", {{"Custom", type date}}),
				  #"Removed columns 1" = Table.RemoveColumns(#"Changed column type 1", {"ReturnDate"}),
				  #"Reordered columns" = Table.ReorderColumns(#"Removed columns 1", {"ReturnID", "OrderID", "Custom", "ProductID", "QuantityReturned", "ReturnReason"}),
				  #"Renamed columns" = Table.RenameColumns(#"Reordered columns", {{"Custom", "ReturnDate"}}),
				  #"Added custom 2" = Table.AddColumn(#"Renamed columns", "QuantityReturnedClean", each if [QuantityReturned] = null then 1 else [QuantityReturned], Int64.Type),
				  #"Added custom 3" = Table.AddColumn(#"Added custom 2", "QuantityReturnedFlagged", each if [QuantityReturned] = null then "imputed" else "Original"),
				  #"Added custom 4" = Table.AddColumn(#"Added custom 3", "BusinessPeriodFlag", each if [ReturnDate] > #date(2026, 12, 31)
				then "Outside Business Period"
				else "Within Business Period")
				in
				  #"Added custom 4"

	annotation PBI_ResultType = Table

